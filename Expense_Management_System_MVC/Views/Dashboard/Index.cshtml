@{
    ViewData["Title"] = "Dashboard";

    var roleId = ViewBag.RoleId?.ToString();
    var name = ViewBag.Name?.ToString();
}

<div class="container-fluid mt-4">

    <div class="mb-4">
        <h2>Welcome, @name</h2>
        <p class="text-muted">
            Expense Management Dashboard
        </p>
    </div>

    <div class="row g-4">

        @* EMPLOYEE *@
        @if (roleId == "1")
        {
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">My Expenses</h5>
                        <p class="card-text">
                            Create, manage and submit your business expenses.
                        </p>

                        <a asp-controller="Expense"
                               asp-action="MyExpenses"
                               class="btn btn-primary">
                            View My Expenses
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">Create Expense</h5>
                        <p class="card-text">
                            Submit a new business expense with supporting details.
                        </p>

                        <a asp-controller="Expense"
                               asp-action="Create"
                               class="btn btn-success">
                            Create Expense
                        </a>
                    </div>
                </div>
            </div>
        }


        @* MANAGER *@
        @if (roleId == "2")
        {
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">Pending Approvals</h5>
                        <p class="card-text">
                            Review employee expenses waiting for approval.
                        </p>

                        <a asp-controller="Expense"
                               asp-action="PendingApprovals"
                               class="btn btn-warning">
                            Review Expenses
                        </a>
                    </div>
                </div>
            </div>
        }


        @* FINANCE *@
        @if (roleId == "3")
        {
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">Reimbursements</h5>
                        <p class="card-text">
                            Manage approved expenses and employee reimbursements.
                        </p>

                        <a asp-controller="Expense"
                               asp-action="Reimbursements"
                               class="btn btn-success">
                            Manage Reimbursements
                        </a>
                    </div>
                </div>
            </div>
        }


        @* SUPER ADMIN *@
        @if (roleId == "4")
        {
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">User Management</h5>
                        <p class="card-text">
                            Create, update and manage system users.
                        </p>

                        <a asp-controller="User"
                               asp-action="Index"
                               class="btn btn-primary">
                            Manage Users
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">Departments</h5>
                        <p class="card-text">
                            Manage company departments.
                        </p>

                        <a asp-controller="Department"
                               asp-action="Index"
                               class="btn btn-primary">
                            Manage Departments
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">Expense Categories</h5>
                        <p class="card-text">
                            Manage expense categories used by employees.
                        </p>

                        <a asp-controller="ExpenseCategory"
                               asp-action="Index"
                               class="btn btn-primary">
                            Manage Categories
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">Reports</h5>
                        <p class="card-text">
                            View monthly expense reports and export data.
                        </p>

                        <a asp-controller="Report"
                               asp-action="Monthly"
                               class="btn btn-dark">
                            View Reports
                        </a>
                    </div>
                </div>
            </div>
        }

    </div>

</div>